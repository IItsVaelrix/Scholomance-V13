# Brazier — embryonic geometry skeleton
# Regenerated from scratch via the Ontological Art-Direction Pipeline.
# All surface detail (rim highlights, band fills, base highlights) is
# provided by art-direction genes in brazier.art-genes.json.
# This file contains ONLY the structural form — zero hand-placed cells.
asset brazier canvas 24x20

palette {
  rim_body  = #383D55
  bowl_body = #191C2D
  stem_dark = #05050D
  base_body = #191C2D
  coal_bed  = #0E1020
}

part rim material obsidian {
  ellipse 12 5 radius 9 ry 2 rim_body
}

part bowl material obsidian {
  polygon 4 7 5 10 7 13 10 14 14 14 17 13 19 10 20 7 bowl_body
}

part stem material obsidian {
  rect 10 14 4 3 stem_dark
}

part base material obsidian {
  polygon 6 19 8 17 16 17 18 19 base_body
}

part interior material source {
  ellipse 12 5 radius 5 ry 1 coal_bed
}
