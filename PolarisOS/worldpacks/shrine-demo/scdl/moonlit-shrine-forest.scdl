# Moonlit Shrine Forest — 160x90 SCDL Scene Graph
asset moonlit_shrine_forest canvas 160x90

palette {
  sky_void       = #030611
  sky_mid        = #0a1128
  moon_glow      = #2c4a75
  moon_pale      = #cbe3f7
  moon_core      = #ffffff
  stardust       = #e0f2fe
  navy_dark      = #0d1b2a
  navy_mid       = #1b263b
  mountain_blue  = #293241
  cyan_glow      = #00f0ff
  cyan_dim       = #0088aa
  stone_dark     = #1e2530
  stone_mid      = #334155
  stone_light    = #64748b
  lantern_warm   = #ffb703
  path_earth     = #2b2118
  path_stone     = #4a3b32
  path_accent    = #5c4d42
  foliage_dark   = #0b1d16
  foliage_moss   = #173829
  foliage_lite   = #2d5a40
  bark_dark      = #120e0b
  bark_mid       = #231b15
  bark_hi        = #3d2f25
  fence_wood     = #382c22
  fence_decay    = #261d16
  gold_rivet     = #ffd700
}

# Layer 1: Dark void sky, full moon at x=105 y=18 r=7 with pale moonlight & stardust core
part sky_and_moon material source {
  rect 0 0 160 90 sky_void
  circle 105 18 radius 22 sky_mid
  circle 105 18 radius 14 moon_glow
  circle 105 18 radius 7 moon_pale
  circle 105 18 radius 4 moon_core
  cell 105 18 stardust
  cell 20 12 stardust
  cell 45 8 stardust
  cell 70 22 stardust
  cell 140 10 stardust
  cell 15 35 stardust
  cell 130 32 stardust
  cell 85 15 stardust
}

# Layer 2: Midnight navy & moonlight blue peak silhouettes
part distant_mountains_and_canopy material source {
  polygon 0 65 25 45 55 60 85 40 115 58 145 35 160 50 160 90 0 90 navy_dark
  polygon 0 68 35 52 65 65 95 48 125 62 160 55 160 90 0 90 navy_mid
  polygon 15 50 25 45 35 52 mountain_blue
  polygon 75 44 85 40 95 48 mountain_blue
  polygon 135 40 145 35 155 48 mountain_blue
}

# Layer 3: Cyan glowing Torii gate at x=98..112 y=28..38, stone stairs x=96..115 y=38..52, stone lanterns at x=90 & x=122
part shrine_and_stairs material source {
  # Torii Gate (cyan glowing)
  rect 99 30 2 8 cyan_glow
  rect 110 30 2 8 cyan_glow
  rect 97 28 17 2 cyan_glow
  rect 98 31 15 1 cyan_glow
  rect 100 29 11 1 cyan_dim

  # Stone Stairs (x=96..115 y=38..52)
  rect 98 38 15 2 stone_light
  rect 97 40 17 2 stone_mid
  rect 97 42 17 2 stone_dark
  rect 96 44 19 2 stone_mid
  rect 96 46 19 2 stone_dark
  rect 96 48 20 2 stone_mid
  rect 95 50 21 2 stone_dark

  # Left Lantern (x=90)
  rect 89 45 4 7 stone_mid
  rect 88 44 6 2 stone_light
  rect 89 42 4 2 lantern_warm
  rect 88 40 6 2 stone_dark

  # Right Lantern (x=122)
  rect 121 45 4 7 stone_mid
  rect 120 44 6 2 stone_light
  rect 121 42 4 2 lantern_warm
  rect 120 40 6 2 stone_dark
}

# Layer 4: Winding earth/stone path from x=70 y=90 to x=105 y=50, dark foliage & moss
part winding_path_and_foliage material source {
  # Dark Foliage and Moss ground base
  polygon 0 70 45 60 70 70 60 90 0 90 foliage_dark
  polygon 80 75 120 52 160 60 160 90 80 90 foliage_dark
  polygon 10 75 40 65 65 75 55 90 10 90 foliage_moss
  polygon 85 80 115 58 150 65 155 90 85 90 foliage_moss
  circle 30 75 radius 6 foliage_lite
  circle 130 70 radius 8 foliage_lite

  # Winding Path (x=70 y=90 to x=105 y=50)
  polygon 60 90 80 90 98 75 92 65 102 54 108 54 99 66 103 76 70 90 path_earth
  polygon 63 90 77 90 96 75 90 65 101 54 107 54 97 66 101 76 67 90 path_stone
  line 65 85 75 85 path_accent
  line 85 72 92 70 path_accent
  line 96 60 102 58 path_accent
}

# Layer 5: Left ancient tree x=8..28 y=0..90 with branch x=20..52 y=15..35, right tree x=135..160 y=0..90, fallen fence planks x=8..44 y=62..77 with gold rivet
part foreground_trees_and_fence material source {
  # Left Tree Trunk & Branch
  polygon 8 90 28 90 24 0 12 0 bark_dark
  polygon 12 90 24 90 21 0 15 0 bark_mid
  polygon 20 30 52 15 50 20 22 35 bark_dark
  polygon 22 28 48 17 46 20 23 32 bark_mid
  circle 15 15 radius 14 foliage_dark
  circle 35 15 radius 10 foliage_dark
  circle 18 12 radius 10 foliage_moss

  # Right Tree
  polygon 135 90 160 90 160 0 142 0 bark_dark
  polygon 138 90 155 90 158 0 145 0 bark_mid
  circle 148 20 radius 12 foliage_dark
  circle 145 15 radius 9 foliage_moss

  # Fallen Fence Planks in bottom-left (x=8..44 y=62..77 with gold rivet)
  polygon 8 70 38 62 40 66 10 74 fence_wood
  line 10 71 37 64 fence_decay
  polygon 12 77 44 68 43 72 11 81 fence_wood
  cell 36 64 gold_rivet
}

export json
