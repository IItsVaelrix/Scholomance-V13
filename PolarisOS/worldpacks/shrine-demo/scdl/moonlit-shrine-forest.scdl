# Moonlit Shrine Forest — 160x90 Master SCDL Scene Graph
asset moonlit_shrine_forest canvas 160x90

palette {
  sky_void       = #030611
  sky_mid        = #0a1128
  moon_glow      = #1b263b
  moon_pale      = #cbe3f7
  moon_core      = #ffffff
  stardust       = #e0f2fe
  navy_dark      = #0d1b2a
  navy_mid       = #1b263b
  mountain_blue  = #293241
  cyan_glow      = #00f0ff
  cyan_dim       = #0088aa
  stone_dark     = #1e2530
  stone_mid      = #334155
  stone_light    = #64748b
  lantern_warm   = #ffb703
  path_earth     = #2b2118
  path_stone     = #4a3b32
  path_accent    = #5c4d42
  path_light     = #c8b8a0
  foliage_dark   = #0b1d16
  foliage_moss   = #173829
  foliage_lite   = #2d5a40
  bark_dark      = #120e0b
  bark_mid       = #231b15
  bark_hi        = #3d2f25
  fence_wood     = #382c22
  fence_decay    = #261d16
  gold_rivet     = #ffd700
}

# Layer 1: Dark void sky & Full Moon
part sky_and_moon material obsidian {
  rect 0 0 160 90 #030611
  polygon 0 0 160 0 160 45 0 35 #0a1128
  polygon 80 0 130 0 120 30 90 25 #1b263b
  circle 105 18 radius 8 #cbe3f7
  circle 105 18 radius 4 #ffffff
  cell 105 18 #ffffff
  cell 20 12 #e0f2fe
  cell 45 8 #e0f2fe
  cell 70 22 #e0f2fe
  cell 140 10 #e0f2fe
  cell 15 35 #e0f2fe
  cell 130 32 #e0f2fe
  cell 85 15 #e0f2fe
}

# Layer 2: Distant Mountains & Forest Canopy Silhouettes
part distant_mountains_and_canopy material obsidian {
  polygon 0 65 25 45 55 60 85 40 115 58 145 35 160 50 160 90 0 90 #0d1b2a
  polygon 0 68 35 52 65 65 95 48 125 62 160 55 160 90 0 90 #1b263b
  polygon 15 50 25 45 35 52 #293241
  polygon 75 44 85 40 95 48 #293241
  polygon 135 40 145 35 155 48 #293241
}

# Layer 3: Cyan Glowing Torii Shrine Gate, Stone Stairs, and Lanterns
part shrine_and_stairs material source {
  # Torii Gate (cyan glowing)
  rect 99 30 2 8 #00f0ff
  rect 110 30 2 8 #00f0ff
  rect 97 28 17 2 #00f0ff
  rect 98 31 15 1 #00f0ff
  rect 100 29 11 1 #0088aa

  # Stone Stairs (x=96..115 y=38..52)
  rect 98 38 15 2 #64748b
  rect 97 40 17 2 #334155
  rect 97 42 17 2 #1e2530
  rect 96 44 19 2 #334155
  rect 96 46 19 2 #1e2530
  rect 96 48 20 2 #334155
  rect 95 50 21 2 #1e2530

  # Left Lantern (x=90)
  rect 89 45 4 7 #334155
  rect 88 44 6 2 #64748b
  rect 89 42 4 2 #ffb703
  rect 88 40 6 2 #1e2530

  # Right Lantern (x=122)
  rect 121 45 4 7 #334155
  rect 120 44 6 2 #64748b
  rect 121 42 4 2 #ffb703
  rect 120 40 6 2 #1e2530
}

# Layer 4: Winding Earth/Stone Path & Ground Foliage Masses
part winding_path_and_foliage material oak_bark {
  # Dark Foliage and Moss ground base
  polygon 0 70 45 60 70 70 60 90 0 90 #0b1d16
  polygon 80 75 120 52 160 60 160 90 80 90 #0b1d16
  polygon 10 75 40 65 65 75 55 90 10 90 #173829
  polygon 85 80 115 58 150 65 155 90 85 90 #173829

  # Winding Path (x=70 y=90 to x=105 y=50)
  polygon 60 90 80 90 98 75 92 65 102 54 108 54 99 66 103 76 70 90 #2b2118
  polygon 63 90 77 90 96 75 90 65 101 54 107 54 97 66 101 76 67 90 #4a3b32
  polygon 65 90 74 90 94 75 88 65 100 54 105 54 95 66 99 76 65 90 #c8b8a0
  line 65 85 75 85 #5c4d42
  line 85 72 92 70 #5c4d42
  line 96 60 102 58 #5c4d42
}

# Layer 5: Ancient Framing Trees & Fallen Wooden Fence
part foreground_trees_and_fence material oak_bark {
  # Left Tree Trunk & Branch
  polygon 8 90 28 90 24 0 12 0 #120e0b
  polygon 12 90 24 90 21 0 15 0 #231b15
  polygon 20 30 52 15 50 20 22 35 #120e0b
  polygon 22 28 48 17 46 20 23 32 #231b15

  # Left Tree Canopy Masses
  polygon 0 0 40 0 35 25 0 20 #0b1d16
  polygon 5 0 35 0 30 20 5 15 #173829

  # Right Tree Trunk & Branch
  polygon 135 90 160 90 160 0 142 0 #120e0b
  polygon 138 90 155 90 158 0 145 0 #231b15
  polygon 138 25 115 15 118 12 142 22 #120e0b

  # Right Tree Canopy Masses
  polygon 120 0 160 0 160 30 125 20 #0b1d16
  polygon 125 0 160 0 160 25 130 15 #173829

  # Fallen Fence Planks in bottom-left
  polygon 8 70 38 62 40 66 10 74 #382c22
  line 10 71 37 64 #261d16
  polygon 12 77 44 68 43 72 11 81 #382c22
  cell 36 64 #ffd700
}

export json
