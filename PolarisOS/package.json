{
  "name": "polaris-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polaris OS — Picture-Book MUD World Kernel (Codex Vale)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:console-ui": "npm --prefix .. run polaris:build-console-ui",
    "build:pixelbrain-assets": "tsx scripts/build-pixelbrain-assets.ts",
    "test": "vitest run",
    "test:browser:pixelbrain": "playwright test --config playwright.pixelbrain.config.ts",
    "test:watch": "vitest",
    "test:kernel": "vitest run packages/world-kernel",
    "test:integration": "vitest run tests/integration",
    "test:persistence": "vitest run tests/persistence",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --quiet",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.1",
    "@types/node": "^20.11.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
