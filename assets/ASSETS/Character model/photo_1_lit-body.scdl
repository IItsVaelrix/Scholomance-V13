# photo_1_lit-body.scdl — body only, 32x32.
# Rows y>=23 of the original art (the dark hem mass that read as the
# character's boots) are REMOVED here: they are replaced by the rigged leg
# segments, not covered by them. Hanging legs below that mass made the figure
# read boots -> legs -> boots (Vaelrix, correctly).

asset photo_1_lit_body canvas 32x32

palette {
  linework_base = #000000
  cloak_shadow  = #070707
  cloak_base    = #161616
  cloak_light   = #B4B4B4
  hair_shadow   = #161616
  hair_base     = #2B2B2B
  hair_hi       = #8D8B8A
  robe_shadow   = #0F0214
  robe_base     = #2D0638
  robe_hi       = #842176
  staff_base    = #F3DD2E
  staff_hi      = #FAFDDF
  face_shadow   = #7E390B
  face_base     = #BC5D1E
  face_light    = #B1632F
  face_hi       = #C97135
  arm_shadow    = #7E390B
  arm_base      = #BC5D1E
  arm_hi        = #FFFFFF
  eyes_shadow   = #0F0214
  eyes_deep     = #2B2B2B
  eyes_base     = #842176
  eyes_light    = #BC5D1E
  eyes_hi       = #FAFDDF
}

# Interior ink detail — eye sockets, mouth, fold lines. NOT a perimeter outline: this sprite has none. Material `source` so transmutation never tints it.
part linework material source {
  cell 12 10 linework_base
  cell 13 10 linework_base
  cell 13 11 linework_base
  cell 17 11 linework_base
  cell 13 12 linework_base
  rect 18 12 4 1 linework_base
  cell 14 13 linework_base
  cell 18 13 linework_base
  cell 22 13 linework_base
  cell 15 14 linework_base
  cell 17 14 linework_base
  cell 19 21 linework_base
  cell 21 21 linework_base
  cell 19 22 linework_base
  cell 22 22 linework_base
}

# Dark cloak mass. 3 tones on the void_cloth ramp: a shadow tone on the right-hand hem/hip cells, a rim-light tone on the true silhouette edge of the left-hand hem (cells whose left neighbour is empty canvas), base unchanged everywhere else. Same light direction Vaelrix's own hand pass already put on the face (face_hi at x=14) and arm (arm_hi at x=12). An earlier pass lit a third of the part by raw x-rank instead of true edges and washed out a pale patch across interior cells hidden behind the hair — reverted after a zoomed render caught it; only 10 of 64 cells are lit, all on the actual silhouette boundary.
part cloak material void_cloth {
  cell 13 7 cloak_base
  cell 13 8 cloak_base
  cell 15 8 cloak_base
  cell 13 9 cloak_base
  cell 16 9 cloak_base
  cell 18 9 cloak_base
  cell 23 14 cloak_shadow
  cell 18 15 cloak_base
  cell 19 15 cloak_base
  cell 23 15 cloak_shadow
  cell 12 16 cloak_light
  cell 13 16 cloak_base
  cell 17 16 cloak_base
  cell 18 16 cloak_base
  cell 23 16 cloak_shadow
  cell 11 17 cloak_light
  cell 14 17 cloak_base
  cell 17 17 cloak_base
  cell 23 17 cloak_shadow
  cell 11 18 cloak_light
  cell 14 18 cloak_base
  cell 17 18 cloak_base
  cell 22 18 cloak_shadow
  cell 12 19 cloak_light
  cell 13 19 cloak_base
  cell 14 19 cloak_base
  rect 18 19 3 1 cloak_base
  cell 21 19 cloak_shadow
  cell 22 19 cloak_shadow
  cell 24 19 cloak_shadow
  cell 15 20 cloak_light
  rect 17 20 3 1 cloak_base
  cell 21 20 cloak_shadow
  cell 24 20 cloak_shadow
  cell 15 21 cloak_light
  cell 17 21 cloak_base
  cell 23 21 cloak_shadow
  cell 24 21 cloak_shadow
  cell 15 22 cloak_light
  cell 17 22 cloak_base
  cell 24 22 cloak_shadow
}

