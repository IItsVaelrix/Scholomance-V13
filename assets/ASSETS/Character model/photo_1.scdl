# Torso, robe, sash, cloak, and arm; paints after head like the source.
part torso material void_cloth {
  rect 20 13 2 1 hair
  cell 19 14 hair
  rect 20 14 2 1 hairhi
  cell 22 14 hair
  cell 14 15 hair
  cell 15 15 skin
  cell 16 15 skinshade
  cell 18 15 hair
  cell 19 15 cloak
  cell 20 15 robe
  cell 21 15 robehi
