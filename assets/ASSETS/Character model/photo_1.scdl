# photo_1.scdl
# 1:1 SCDL conversion of the supplied Photo 1.jpg pixel sprite.
# The source is a 32x32 grid enlarged to 1280x1280; transparent cells remain
# empty. Two parts preserve the original head-over-torso painter order.

asset photo_1 canvas 32x32

palette {
  ink        = #000000
  cloak      = #161616
  robedeep   = #2E0631
  robe       = #320636
  hair       = #3F3E3E
  robehi     = #4B1451
  skindeep   = #59390A
  hairhi     = #797676
  skinshade  = #9D630E
  skin       = #BC7206
  sash       = #C9C10C
  sashhi     = #E4DA0E
  shine      = #F6F4F1
  white      = #FFFFFF
}

# Head, hair, face, and right-side fall.
part head material hair_black {
  rect 15 4 2 1 hair
  cell 17 4 cloak
  rect 18 4 2 1 hair
  rect 13 5 2 1 hair
  cell 15 5 hairhi
  cell 16 5 hair
  rect 17 5 2 1 hairhi
  rect 19 5 2 1 hair
  cell 12 6 hair
  cell 13 6 hairhi
  cell 14 6 cloak
  cell 15 6 hair
  cell 16 6 hairhi
  rect 17 6 2 1 hair
  rect 19 6 2 1 hairhi
  cell 21 6 hair
  cell 12 7 hairhi
  cell 13 7 cloak
  rect 14 7 2 1 hairhi
  cell 16 7 hair
  rect 17 7 2 1 hairhi
  cell 19 7 hair
  cell 20 7 hairhi
  cell 21 7 hair
  cell 12 8 hairhi
