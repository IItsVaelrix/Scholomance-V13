# photo_1_segments.scdl
# Segmented form of photo_1.scdl. Generated, not hand-authored: every cell is
# carried over from photo_1.scdl unchanged — identical coordinates, identical
# palette aliases. The ONLY change is which part each cell belongs to, so the
# compiled raster is pixel-identical to photo_1-png.png (verified by diff).
#
# Why: photo_1.scdl had two parts (head / torso) split by painter order, which
# is not a modification surface — recolouring the robe meant hand-picking cells
# out of a 100-line block. These eight parts are split by MEANING, so each is
# independently addressable for material transmutation, effects, and geometry
# edits.
#
# Segment map and cell counts:
#   linework  18 cells   material source
#   cloak     63 cells   material void_cloth
#   hair      91 cells   material hair_black
#   robe      28 cells   material void_cloth
#   staff      7 cells   material gold
#   face      19 cells   material skin_medium
#   arm        6 cells   material skin_medium
#   eyes       2 cells   material eye_void_glow
#   TOTAL    234 cells
#
# Classification is by palette alias, plus one spatial rule: skin cells at
# y<=15 are `face`, y>=16 are `arm`. That boundary is the only judgement call
# in this file — if a cell is on the wrong side of it, move the line.
#
# Materials are semantic labels, not a recolour: the canonical compile renders
# the authored colours regardless. They take effect under transmutation or
# `--shade material`. Verify any id against material-registry.js before changing.

asset photo_1_segments canvas 32x32

palette {
  ink        = #000000
  cloak      = #161616
  robedeep   = #2E0631
  robe       = #320636
  hair       = #3F3E3E
  robehi     = #4B1451
  skindeep   = #59390A
  hairhi     = #797676
  skinshade  = #9D630E
  skin       = #BC7206
  sash       = #C9C10C
  sashhi     = #E4DA0E
  shine      = #F6F4F1
  white      = #FFFFFF
}

# Interior ink detail — eye sockets, mouth, fold lines. NOT a perimeter outline: this sprite has none. Keep material `source` so transmutation never tints the black linework.
part linework material source {
  cell 12 10 ink
  cell 13 11 ink
  cell 17 11 ink
  cell 13 12 ink
  rect 19 12 3 1 ink
  cell 14 13 ink
  cell 18 13 ink
  cell 22 13 ink
  cell 15 14 ink
  cell 17 14 ink
  cell 19 21 ink
  cell 21 21 ink
  cell 19 22 ink
  cell 22 22 ink
  cell 20 23 ink
  cell 21 23 ink
}

