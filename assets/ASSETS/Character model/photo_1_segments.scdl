# Purple robe body — robe / robehi / robedeep.
part robe material void_cloth {
  cell 20 15 robe
  cell 21 15 robehi
  cell 22 15 robe
  cell 15 16 robe
  cell 20 16 robe
  cell 21 16 robehi
  cell 22 16 robehi
  cell 18 17 robehi
  cell 19 17 robe
  cell 20 17 robehi
  cell 21 17 robehi
  cell 22 17 robe
  rect 18 18 4 1 robe
  cell 18 22 robedeep
  cell 16 23 robehi
  cell 18 23 robe
