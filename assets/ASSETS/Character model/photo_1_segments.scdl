# Gold vertical staff and its bright cells.
part staff material gold {
  cell 14 16 sash
  cell 16 16 sash
  cell 16 17 sashhi
  cell 17 19 sash
  cell 16 21 sash
  cell 18 21 sash
  cell 16 22 sashhi
}

# Head skin, y<=15: brow, cheek, jaw.
part face material skin_medium {
  cell 15 9 skindeep
  cell 14 10 skinshade
  cell 15 10 skindeep
  cell 18 10 skin
  cell 14 11 skinshade
  cell 15 11 skindeep
  cell 18 11 skinshade
  rect 14 12 3 1 skinshade
  cell 17 12 skin
  cell 15 13 skinshade
  cell 16 13 skin
  cell 19 13 skin
  cell 16 14 skin
  cell 18 14 skin
  cell 15 15 skin
  cell 16 15 skinshade
  cell 17 15 skin
}

# Extended arm and gripping hand, y>=16. Same material as `face`; separate so you can repose the arm without touching the head.
part arm material skin_medium {
  cell 12 17 white
  cell 13 17 skinshade
  cell 15 17 skin
  cell 12 18 skinshade
  cell 13 18 skin
  cell 16 20 skin
}

# The two-cell eye highlight. Add `glow radius 2` here for an emissive read.
part eyes material eye_void_glow {
  cell 16 10 shine
  cell 16 11 shine
}

export json png svg aseprite
