part cloak material void_cloth {
  cell 17 4 cloak
  cell 14 6 cloak
  cell 13 7 cloak
  cell 13 8 cloak
  cell 15 8 cloak
  cell 13 9 cloak
  cell 16 9 cloak
  cell 18 9 cloak
  cell 23 14 cloak
