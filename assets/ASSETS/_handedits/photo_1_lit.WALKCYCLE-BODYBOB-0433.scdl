# photo_1_lit.scdl
# Source of truth for the character. Rebuilt from Vaelrix's 30-minute hand pass
# (2026-08-30 16:59), so that work lives HERE, not only in a generated output.
# Every pixel below is Vaelrix's; this file only re-expresses it as SCDL.
#
# ── WARNING ───────────────────────────────────────────────────────────────
# `photo_1_lit-aseprite.aseprite` is an OUTPUT. Compiling this file with
# `--export aseprite` overwrites it without asking. If you hand-edit that
# .aseprite, back the change into this .scdl before recompiling, or the edit
# is gone. A dated copy of the 2026-08-30 face fix is kept in
# assets/ASSETS/_handedits/.
#
# ── Palette aliases are NAMESPACED PER PART, on purpose ───────────────────
# SCDL palette aliases are global. An earlier generator wrote per-part values
# into shared aliases (`skin`, `skinshade`), so `arm` silently overwrote
# `face` and the face rendered with the arm's colours. Every alias below is
# prefixed with its part id, which makes that class of bug impossible.
# Tone suffixes run dark -> light: shadow, deep, base, light, hi.
#
#   linework   20 cells  1 tone(s)  material source
#   cloak      64 cells  3 tone(s)  material void_cloth
#   hair       88 cells  3 tone(s)  material hair_black
#   robe       31 cells  3 tone(s)  material void_cloth
#   staff       7 cells  2 tone(s)  material gold
#   face       16 cells  4 tone(s)  material skin_medium
#   arm         6 cells  3 tone(s)  material skin_medium
#   eyes       10 cells  5 tone(s)  material eye_void_glow
#   feet        8 cells  1 tone(s)  material void_cloth
#   TOTAL     250 cells
#
# Walk cycle: loop `walk`, 200ms/frame, 4 frames + implicit rest (frame 0).
# EVERY part bobs 1px with the footfall (body dips on stride-L/stride-R
# contact, rises on pass-mid/pass-mid2) — a feet-only stride didn't read as
# the character walking, it read as noise at the hem (Vaelrix, correctly,
# on the first two attempts). It's a pure translation of existing pixels,
# nothing reshaped or redrawn. Boots also carry 2 tones now (base/shadow)
# instead of one flat block.

asset photo_1_lit canvas 32x32

palette {
  linework_base = #000000
  cloak_shadow  = #070707
  cloak_base    = #161616
  cloak_light   = #B4B4B4
  hair_shadow   = #161616
  hair_base     = #2B2B2B
  hair_hi       = #8D8B8A
  robe_shadow   = #0F0214
  robe_base     = #2D0638
  robe_hi       = #842176
  staff_base    = #F3DD2E
  staff_hi      = #FAFDDF
  face_shadow   = #7E390B
  face_base     = #BC5D1E
  face_light    = #B1632F
  face_hi       = #C97135
  arm_shadow    = #7E390B
  arm_base      = #BC5D1E
  arm_hi        = #FFFFFF
  eyes_shadow   = #0F0214
  eyes_deep     = #2B2B2B
  eyes_base     = #842176
  eyes_light    = #BC5D1E
  eyes_hi       = #FAFDDF
}

# Interior ink detail — eye sockets, mouth, fold lines. NOT a perimeter outline: this sprite has none. Material `source` so transmutation never tints it.
part linework material source {
  cell 12 10 linework_base
  cell 13 10 linework_base
  cell 13 11 linework_base
  cell 17 11 linework_base
  cell 13 12 linework_base
  rect 18 12 4 1 linework_base
  cell 14 13 linework_base
  cell 18 13 linework_base
  cell 22 13 linework_base
  cell 15 14 linework_base
  cell 17 14 linework_base
  cell 19 21 linework_base
  cell 21 21 linework_base
  cell 19 22 linework_base
  cell 22 22 linework_base
  cell 20 23 linework_base
  cell 21 23 linework_base
}

# Dark cloak mass. 3 tones on the void_cloth ramp: a shadow tone on the right-hand hem/hip cells, a rim-light tone on the true silhouette edge of the left-hand hem (cells whose left neighbour is empty canvas), base unchanged everywhere else. Same light direction Vaelrix's own hand pass already put on the face (face_hi at x=14) and arm (arm_hi at x=12). An earlier pass lit a third of the part by raw x-rank instead of true edges and washed out a pale patch across interior cells hidden behind the hair — reverted after a zoomed render caught it; only 10 of 64 cells are lit, all on the actual silhouette boundary.
part cloak material void_cloth {
  cell 13 7 cloak_base
  cell 13 8 cloak_base
  cell 15 8 cloak_base
  cell 13 9 cloak_base
  cell 16 9 cloak_base
  cell 18 9 cloak_base
  cell 23 14 cloak_shadow
  cell 18 15 cloak_base
