part arm material skin_medium {
  cell 12 17 arm_hi
  cell 13 17 arm_shadow
  cell 15 17 arm_base
  cell 12 18 arm_shadow
  cell 13 18 arm_base
  cell 16 20 arm_base
}

# Eye and brow region, hand-authored by Vaelrix 2026-08-30. The part that made the head finally read.
part eyes material eye_void_glow {
  cell 14 4 eyes_deep
  cell 15 9 eyes_base
  cell 15 10 eyes_base
  cell 16 10 eyes_hi
  cell 23 10 eyes_deep
  cell 15 11 eyes_base
  cell 16 11 eyes_hi
  cell 24 12 eyes_deep
  cell 16 14 eyes_light
  cell 14 15 eyes_shadow
}


# Boots peeking below the cloak hem. Each is a fixed 2x2 block that
# TRANSLATES to a new position every frame (forward+down when planted,
# back+up into the hem shadow when lifted) — v2 kept a corner anchored and
# only grew the block downward, which read as the leg stretching in place
# rather than a foot moving (caught by Vaelrix on the second version too).
part feet material void_cloth {
    cell 16 27 cloak_base
    cell 17 27 cloak_base
    cell 20 27 cloak_base
    cell 21 27 cloak_base
    cell 16 28 cloak_shadow
    cell 17 28 cloak_shadow
    cell 20 28 cloak_shadow
    cell 21 28 cloak_shadow
}


