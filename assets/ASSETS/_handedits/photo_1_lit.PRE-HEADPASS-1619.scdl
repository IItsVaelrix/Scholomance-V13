# photo_1_lit.scdl
# Source of truth for the relit character. Rebuilt from the hand-edited
# aseprite on 2026-08-30, so Vaelrix's face correction lives HERE, not only in
# a generated output file.
#
# ── WARNING ───────────────────────────────────────────────────────────────
# `photo_1_lit-aseprite.aseprite` is an OUTPUT. Compiling this file with
# `--export aseprite` overwrites it without asking. If you hand-edit that
# .aseprite, back the change into this .scdl before recompiling, or the edit
# is gone. A dated copy of the 2026-08-30 face fix is kept in
# assets/ASSETS/_handedits/.
#
# ── Palette aliases are NAMESPACED PER PART, on purpose ───────────────────
# SCDL palette aliases are global. An earlier generator wrote per-part values
# into shared aliases (`skin`, `skinshade`), so `arm` silently overwrote
# `face` and the face rendered with the arm's colours. Every alias below is
# prefixed with its part id, which makes that class of bug impossible.
# Tone suffixes run dark -> light: shadow, deep, base, light, hi.
#
#   linework   18 cells  1 tone(s)  material source
#   cloak      63 cells  1 tone(s)  material void_cloth
#   hair       91 cells  2 tone(s)  material hair_black
#   robe       28 cells  3 tone(s)  material void_cloth
#   staff       7 cells  2 tone(s)  material gold
#   face       19 cells  4 tone(s)  material skin_medium
#   arm         6 cells  3 tone(s)  material skin_medium
#   eyes        2 cells  1 tone(s)  material eye_void_glow
#   TOTAL     234 cells

asset photo_1_lit canvas 32x32

palette {
  linework_base = #000000
  cloak_base    = #161616
  hair_base     = #2B2B2B
  hair_hi       = #8D8B8A
  robe_shadow   = #0F0214
  robe_base     = #2D0638
  robe_hi       = #842176
  staff_base    = #F3DD2E
  staff_hi      = #FAFDDF
  face_shadow   = #7C390E
  face_base     = #7E390B
  face_light    = #BC5D1E
  face_hi       = #B1632F
  arm_shadow    = #7E390B
  arm_base      = #BC5D1E
  arm_hi        = #FFFFFF
  eyes_base     = #F6F4F1
}

# Interior ink detail — eye sockets, mouth, fold lines. NOT a perimeter outline: this sprite has none. Material `source` so transmutation never tints it.
part linework material source {
  cell 12 10 linework_base
  cell 13 11 linework_base
  cell 17 11 linework_base
  cell 13 12 linework_base
  rect 19 12 3 1 linework_base
  cell 14 13 linework_base
  cell 18 13 linework_base
  cell 22 13 linework_base
  cell 15 14 linework_base
  cell 17 14 linework_base
  cell 19 21 linework_base
  cell 21 21 linework_base
  cell 19 22 linework_base
  cell 22 22 linework_base
  cell 20 23 linework_base
  cell 21 23 linework_base
}

# Dark cloak mass. Still ONE flat tone across 63 cells — giving it form is a light-placement decision, not a palette one.
part cloak material void_cloth {
  cell 17 4 cloak_base
  cell 14 6 cloak_base
  cell 13 7 cloak_base
  cell 13 8 cloak_base
  cell 15 8 cloak_base
  cell 13 9 cloak_base
  cell 16 9 cloak_base
  cell 18 9 cloak_base
  cell 23 14 cloak_base
  cell 19 15 cloak_base
  cell 23 15 cloak_base
  cell 12 16 cloak_base
  cell 13 16 cloak_base
  cell 18 16 cloak_base
  cell 19 16 cloak_base
  cell 23 16 cloak_base
  cell 11 17 cloak_base
  cell 14 17 cloak_base
  cell 17 17 cloak_base
  cell 23 17 cloak_base
  cell 11 18 cloak_base
  cell 14 18 cloak_base
  cell 17 18 cloak_base
  cell 22 18 cloak_base
  rect 12 19 3 1 cloak_base
  rect 18 19 5 1 cloak_base
  cell 24 19 cloak_base
  cell 15 20 cloak_base
  cell 17 20 cloak_base
  cell 18 20 cloak_base
  cell 21 20 cloak_base
  cell 24 20 cloak_base
  cell 15 21 cloak_base
  cell 17 21 cloak_base
  cell 23 21 cloak_base
  cell 24 21 cloak_base
  cell 15 22 cloak_base
  cell 17 22 cloak_base
  cell 24 22 cloak_base
  cell 15 23 cloak_base
  cell 17 23 cloak_base
  cell 23 23 cloak_base
  cell 14 24 cloak_base
  cell 17 24 cloak_base
  cell 22 24 cloak_base
  rect 14 25 3 1 cloak_base
  cell 20 25 cloak_base
  cell 22 25 cloak_base
  rect 16 26 7 1 cloak_base
}

