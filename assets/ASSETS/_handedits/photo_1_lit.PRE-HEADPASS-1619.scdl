# Gold vertical staff.
part staff material gold {
  cell 14 16 staff_base
  cell 16 16 staff_base
  cell 16 17 staff_hi
  cell 17 19 staff_base
  cell 16 21 staff_base
  cell 18 21 staff_base
  cell 16 22 staff_hi
}

# Head skin, y<=15. Hand-corrected by Vaelrix 2026-08-30 — four tones, kept verbatim.
part face material skin_medium {
  cell 15 9 face_shadow
  cell 14 10 face_hi
  cell 15 10 face_shadow
  cell 18 10 face_light
  cell 14 11 face_hi
  cell 15 11 face_shadow
  cell 18 11 face_base
  rect 14 12 3 1 face_hi
  cell 17 12 face_light
  cell 15 13 face_hi
  cell 16 13 face_light
  cell 19 13 face_light
  cell 16 14 face_light
  cell 18 14 face_light
  cell 15 15 face_light
  cell 16 15 face_base
  cell 17 15 face_light
}

# Extended arm and gripping hand, y>=16. Includes the white specular accent.
part arm material skin_medium {
  cell 12 17 arm_hi
  cell 13 17 arm_shadow
  cell 15 17 arm_base
  cell 12 18 arm_shadow
  cell 13 18 arm_base
  cell 16 20 arm_base
}

# Two-cell eye highlight. Add `glow radius 2` here for an emissive read.
part eyes material eye_void_glow {
  cell 16 10 eyes_base
  cell 16 11 eyes_base
}

export json png svg aseprite
