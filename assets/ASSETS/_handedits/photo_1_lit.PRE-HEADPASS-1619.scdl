  cell 20 22 hair_base
  cell 21 22 hair_hi
  cell 22 23 hair_base
  cell 18 24 hair_base
  cell 19 24 hair_hi
}

# Purple robe body.
part robe material void_cloth {
  cell 20 15 robe_base
  cell 21 15 robe_hi
  cell 22 15 robe_base
  cell 15 16 robe_base
  cell 20 16 robe_base
  cell 21 16 robe_hi
  cell 22 16 robe_hi
  cell 18 17 robe_hi
  cell 19 17 robe_base
  cell 20 17 robe_hi
  cell 21 17 robe_hi
  cell 22 17 robe_base
  rect 18 18 4 1 robe_base
  cell 18 22 robe_shadow
  cell 16 23 robe_hi
  cell 18 23 robe_base
  cell 19 23 robe_hi
  cell 15 24 robe_base
  cell 16 24 robe_hi
  cell 20 24 robe_base
