part blade_core material cyan_lightning {
  glow radius 2
  # Wand mathematical_stroke, propagated per WAND_CHEMICAL_STROKE_PROPAGATION:
  # piecewise stroke along the blade's own centroid spine (tip->hilt
  # via-points derived from the blade part's real geometry), quantized to
  # the pixel grid and clipped to the blade footprint. See
  # wand-stroke-vein2.mjs for the derivation.
  cell 23 5 c4
  cell 24 6 c4
  cell 24 7 c4
  cell 24 8 c4
  cell 24 9 c4
  cell 24 10 c4
  cell 23 11 c4
  cell 22 12 c4
  cell 22 13 c4
  cell 21 14 c4
  cell 20 15 c4
  cell 20 16 c4
  cell 18 17 c4
  cell 15 18 c4
  cell 14 19 c4
  cell 13 20 c4
  cell 12 21 c4
  cell 11 22 c4
  # recursive sub-unfolding: short branch spark off the mid-vein, same
  # stroke formula at smaller scale, reaching the blade's outer edge
  cell 26 9 c4
}

