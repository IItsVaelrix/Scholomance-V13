{
  "_about": "Canonical YouTube URL policy for DivTube, asserted by BOTH the Java companion (src/test/java/divtube/validation/YouTubeUrlConformanceTest.java) and the Python cockpit (tests/test_url_policy_conformance.py). The same URL must produce the same verdict in both languages. This file exists because protocol.py and YouTubeUrlValidator.java previously carried allowlists that had drifted apart in opposite directions: Java accepted music.youtube.com's siblings but not music.youtube.com itself, Python accepted hosts Java refused, and neither agreed on what a valid path was.",
  "_intentional_difference": "Scheme policy is deliberately NOT covered here. The desktop validator accepts http and https; the remote protocol requires https because its URLs arrive from a paired device over the network. Each layer pins its own scheme rule in its own test suite. Every case below uses https so the table stays meaningful to both.",
  "cases": [
    { "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://youtube.com/watch?v=dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://m.youtube.com/watch?v=dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://music.youtube.com/watch?v=dQw4w9WgXcQ", "expect": "accept", "note": "YouTube Music is a real YouTube property; Java used to refuse it" },
    { "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ&t=42s", "expect": "accept" },
    { "url": "https://www.youtube.com/watch?list=PL123&v=dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ&index=2&list=PL123", "expect": "accept" },
    { "url": "https://youtu.be/dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://www.youtu.be/dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://youtu.be/dQw4w9WgXcQ?si=Kx1a", "expect": "accept" },
    { "url": "https://www.youtube.com/shorts/dQw4w9WgXcQ", "expect": "accept", "note": "Shorts; Java used to refuse them while the remote protocol accepted them" },
    { "url": "https://www.youtube.com/live/dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://www.youtube.com/embed/dQw4w9WgXcQ", "expect": "accept" },
    { "url": "https://WWW.YouTube.COM/watch?v=dQw4w9WgXcQ", "expect": "accept", "note": "host comparison is case-insensitive" },

    { "url": "https://evil.example/?x=/youtube.com/watch?v=a", "expect": "reject", "note": "the substring check's canonical failure" },
    { "url": "http://youtube.com.attacker.tld/watch?v=x", "expect": "reject" },
    { "url": "https://youtube.com.attacker.tld/watch?v=dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://notyoutube.com/watch?v=dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://youtube.com.evil.co/watch?v=dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://evil.youtu.be.attacker.tld/dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://xyoutube.com/watch?v=dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://evil.example/youtube.com/watch?v=dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://evil.example#youtube.com/watch?v=a", "expect": "reject" },
    { "url": "https://youtube.com@evil.example/watch?v=dQw4w9WgXcQ", "expect": "reject", "note": "userinfo trick; authority is evil.example" },
    { "url": "https://youtu.be@evil.example/dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://admin:pw@youtube.com/watch?v=dQw4w9WgXcQ", "expect": "reject", "note": "credentials in a download URL are never legitimate" },
    { "url": "https://youtube.com:22/watch?v=dQw4w9WgXcQ", "expect": "reject", "note": "non-default port redirects the request to an attacker-chosen endpoint" },
    { "url": "https://youtube.com:8080/shorts/dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://youtube.com:443/watch?v=dQw4w9WgXcQ", "expect": "accept", "note": "an explicit default port is harmless" },
    { "url": "https://www.youtube.com.%65vil.example/watch?v=dQw4w9WgXcQ", "expect": "reject" },
    { "url": "https://xn--youtbe-nya.com/watch?v=dQw4w9WgXcQ", "expect": "reject", "note": "punycode lookalike" },
    { "url": "https://142.250.0.1/watch?v=dQw4w9WgXcQ", "expect": "reject", "note": "bare IP is never an allowlisted host" },

    { "url": "https://www.youtube.com/", "expect": "reject" },
    { "url": "https://www.youtube.com", "expect": "reject" },
    { "url": "https://www.youtube.com/feed/subscriptions", "expect": "reject", "note": "real host, not a downloadable target" },
    { "url": "https://www.youtube.com/watch", "expect": "reject", "note": "no v= parameter" },
    { "url": "https://www.youtube.com/watch?list=PL123", "expect": "reject", "note": "playlist but no video" },
    { "url": "https://www.youtube.com/channel/UCX6OQ3DkcsbYNE6H8uQQuVA", "expect": "reject" },
    { "url": "https://youtu.be/", "expect": "reject" },
    { "url": "https://youtu.be", "expect": "reject" },
    { "url": "https://www.youtube.com/shorts/", "expect": "reject" },
    { "url": "https://www.youtube.com/playlist?list=PL123", "expect": "reject" },

    { "url": "", "expect": "reject" },
    { "url": "   ", "expect": "reject" },
    { "url": "not a url at all", "expect": "reject" },
    { "url": "https://", "expect": "reject" },
    { "url": "https://[bad", "expect": "reject" },
    { "url": "\u0000", "expect": "reject", "note": "control byte, not whitespace" },
    { "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ\u0000", "expect": "reject", "note": "trailing NUL must survive stripping and still be refused" },

    { "url": "https://www.youtube.com/watch?v=x", "expect": "accept", "note": "no length minimum on the video id; inventing one is a guess about someone else's identifier format and it broke short synthetic ids in tests" },
    { "url": "https://youtu.be/abc", "expect": "accept" },
    { "url": "https://www.youtube.com/watch?v=abc123", "expect": "accept" },
    { "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ-", "expect": "accept", "note": "- and _ are in the real alphabet" },
    { "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ~", "expect": "reject", "note": "charset is the security property: nothing outside it reaches the argument vector" },
    { "url": "https://www.youtube.com/watch?v=../../etc/passwd", "expect": "reject", "note": "path traversal cannot hide in the v= parameter" },
    { "url": "https://youtu.be/..%2f..%2fetc", "expect": "reject" },
    { "url": "https://www.youtube.com/watch?v=a b", "expect": "reject" },
    { "url": "https://www.youtube.com/watch?v=", "expect": "reject", "note": "empty id" }
  ]
}
