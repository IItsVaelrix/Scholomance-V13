SCDL 2
ASSET scholo_weeping_voidmaple
CANVAS WIDTH 48 HEIGHT 64
BUDGET INSTRUCTIONS 20000 GENERATED_SHAPES 500 RASTER_CELLS 16384 RECURSION_DEPTH 16
SELECT_AMPS PIPELINE render-fidelity
# APPLY_AMP pixelbrain.fibonacci-seed-field
# SHADER canopy_masses FOLIAGE
# SHADER surface_detail BARK_DETAIL

CONST $cx I32 24
CONST $gy I32 56

# Palette declarations for theme autumn_scarlet_gold
CONST $canopy_spec COLOR #FDE047
CONST $canopy_hi COLOR #F97316
CONST $canopy_lit COLOR #EF4444
CONST $canopy_mid COLOR #DC2626
CONST $canopy_base COLOR #991B1B
CONST $canopy_dark COLOR #450A0A
CONST $bark_lit COLOR #78716C
CONST $bark_mid COLOR #57534E
CONST $bark_base COLOR #292524
CONST $bark_dark COLOR #1C1917
CONST $shadow_abyss COLOR #04060E

# --- Semantic Layer 1: ground_shadow ---
SHAPE $sh_core (CIRCLE CENTER (VEC2 (PX $cx) (PX $gy)) RADIUS (PX 15))
SHAPE $sh_ring (ELLIPSE CENTER (VEC2 (PX $cx) (PX $gy)) RADIUS_X (PX 19) RADIUS_Y (PX 4))
LAYER ground_shadow ORDER 5 {
  PAINT $sh_ring FILL $shadow_abyss RASTER MIDPOINT
  PAINT $sh_core FILL $shadow_abyss RASTER MIDPOINT
}

# --- Semantic Layer 2: roots_and_ground ---
SHAPE $r_l (LINE FROM (VEC2 (PX (SUB $cx 10)) (PX $gy)) TO (VEC2 (PX (SUB $cx 3)) (PX (SUB $gy 5))))
SHAPE $r_r (LINE FROM (VEC2 (PX (ADD $cx 10)) (PX $gy)) TO (VEC2 (PX (ADD $cx 3)) (PX (SUB $gy 5))))
LAYER roots_and_ground ORDER 10 {
  PAINT $r_l FILL $bark_dark RASTER MIDPOINT
  PAINT $r_r FILL $bark_mid RASTER MIDPOINT
}

# --- Semantic Layer 3: trunk ---
SHAPE $t_base (RECT CENTER (VEC2 (PX $cx) (PX (SUB $gy 5))) SIZE (VEC2 (PX 12) (PX 10)))
SHAPE $t_mid (RECT CENTER (VEC2 (PX $cx) (PX 39)) SIZE (VEC2 (PX 9) (PX 34)))
SHAPE $t_sh (RECT CENTER (VEC2 (PX (SUB $cx 3)) (PX 39)) SIZE (VEC2 (PX 2) (PX 34)))
SHAPE $t_hi (RECT CENTER (VEC2 (PX (ADD $cx 3)) (PX 39)) SIZE (VEC2 (PX 2) (PX 34)))
LAYER trunk ORDER 20 {
  PAINT $t_base FILL $bark_base RASTER MIDPOINT
  PAINT $t_mid FILL $bark_mid RASTER MIDPOINT
  PAINT $t_sh FILL $bark_dark RASTER MIDPOINT
  PAINT $t_hi FILL $bark_lit RASTER MIDPOINT
}

# --- Semantic Layer 4: primary_branches ---
SHAPE $b_fork_l (LINE FROM (VEC2 (PX $cx) (PX 30)) TO (VEC2 (PX (SUB $cx 14)) (PX 18)))
SHAPE $b_fork_r (LINE FROM (VEC2 (PX $cx) (PX 30)) TO (VEC2 (PX (ADD $cx 14)) (PX 18)))
SHAPE $b_fork_c (LINE FROM (VEC2 (PX $cx) (PX 28)) TO (VEC2 (PX $cx) (PX 12)))
LAYER primary_branches ORDER 30 {
  PAINT $b_fork_l FILL $bark_base RASTER MIDPOINT
  PAINT $b_fork_r FILL $bark_mid RASTER MIDPOINT
  PAINT $b_fork_c FILL $bark_mid RASTER MIDPOINT
}

# --- Semantic Layer 5: secondary_branches ---
SHAPE $tw_ml (LINE FROM (VEC2 (PX (SUB $cx 14)) (PX 18)) TO (VEC2 (PX (SUB $cx 18)) (PX 10)))
SHAPE $tw_mr (LINE FROM (VEC2 (PX (ADD $cx 14)) (PX 18)) TO (VEC2 (PX (ADD $cx 18)) (PX 10)))
LAYER secondary_branches ORDER 40 {
  PAINT $tw_ml FILL $bark_lit RASTER MIDPOINT
  PAINT $tw_mr FILL $bark_lit RASTER MIDPOINT
}

# --- Semantic Layer 6: canopy_masses ---
SHAPE $pil_bl (CIRCLE CENTER (VEC2 (PX (SUB $cx 14)) (PX 24)) RADIUS (PX 9))
SHAPE $pil_br (CIRCLE CENTER (VEC2 (PX (ADD $cx 14)) (PX 24)) RADIUS (PX 9))
SHAPE $pil_bc (CIRCLE CENTER (VEC2 (PX $cx) (PX 22)) RADIUS (PX 11))
SHAPE $pil_ml (CIRCLE CENTER (VEC2 (PX (SUB $cx 10)) (PX 12)) RADIUS (PX 10))
SHAPE $pil_mr (CIRCLE CENTER (VEC2 (PX (ADD $cx 10)) (PX 12)) RADIUS (PX 10))
SHAPE $pil_flank_l (CIRCLE CENTER (VEC2 (PX (SUB $cx 17)) (PX 17)) RADIUS (PX 7))
SHAPE $pil_flank_r (CIRCLE CENTER (VEC2 (PX (ADD $cx 17)) (PX 17)) RADIUS (PX 7))
SHAPE $pil_top (CIRCLE CENTER (VEC2 (PX $cx) (PX 4)) RADIUS (PX 9))
SHAPE $crevice_l (CIRCLE CENTER (VEC2 (PX (SUB $cx 4)) (PX 14)) RADIUS (PX 4))
SHAPE $crevice_r (CIRCLE CENTER (VEC2 (PX (ADD $cx 4)) (PX 14)) RADIUS (PX 4))
LAYER canopy_masses ORDER 50 {
  PAINT $pil_bl FILL $canopy_dark RASTER MIDPOINT
  PAINT $pil_br FILL $canopy_dark RASTER MIDPOINT
  PAINT $pil_bc FILL $canopy_base RASTER MIDPOINT
  PAINT $pil_ml FILL $canopy_mid RASTER MIDPOINT
  PAINT $pil_mr FILL $canopy_lit RASTER MIDPOINT
  PAINT $pil_flank_l FILL $canopy_mid RASTER MIDPOINT
  PAINT $pil_flank_r FILL $canopy_lit RASTER MIDPOINT
  PAINT $pil_top FILL $canopy_lit RASTER MIDPOINT
  PAINT $crevice_l FILL $canopy_dark RASTER MIDPOINT
  PAINT $crevice_r FILL $canopy_dark RASTER MIDPOINT
}

# --- Semantic Layer 7: foliage_edges ---
SHAPE $fe_l1 (CIRCLE CENTER (VEC2 (PX (SUB $cx 18)) (PX 18)) RADIUS (PX 4))
SHAPE $fe_r1 (CIRCLE CENTER (VEC2 (PX (ADD $cx 18)) (PX 18)) RADIUS (PX 4))
SHAPE $fe_l2 (CIRCLE CENTER (VEC2 (PX (SUB $cx 11)) (PX 8)) RADIUS (PX 4))
SHAPE $fe_r2 (CIRCLE CENTER (VEC2 (PX (ADD $cx 11)) (PX 8)) RADIUS (PX 4))
SHAPE $fe_top (CIRCLE CENTER (VEC2 (PX $cx) (PX 0)) RADIUS (PX 4))
LAYER foliage_edges ORDER 60 {
  PAINT $fe_l1 FILL $canopy_hi RASTER MIDPOINT
  PAINT $fe_r1 FILL $canopy_hi RASTER MIDPOINT
  PAINT $fe_l2 FILL $canopy_hi RASTER MIDPOINT
  PAINT $fe_r2 FILL $canopy_hi RASTER MIDPOINT
  PAINT $fe_top FILL $canopy_hi RASTER MIDPOINT
}

# --- Semantic Layer 8: surface_detail ---
SHAPE $bark_f1 (LINE FROM (VEC2 (PX (SUB $cx 2)) (PX (SUB $gy 20))) TO (VEC2 (PX (SUB $cx 2)) (PX 26)))
SHAPE $bark_f2 (LINE FROM (VEC2 (PX (ADD $cx 1)) (PX (SUB $gy 18))) TO (VEC2 (PX (ADD $cx 1)) (PX 28)))
SHAPE $bark_ridge (LINE FROM (VEC2 (PX (ADD $cx 3)) (PX (SUB $gy 16))) TO (VEC2 (PX (ADD $cx 3)) (PX 30)))
LAYER surface_detail ORDER 70 {
  PAINT $bark_f1 FILL $bark_dark RASTER MIDPOINT
  PAINT $bark_f2 FILL $bark_dark RASTER MIDPOINT
  PAINT $bark_ridge FILL $bark_lit RASTER MIDPOINT
}

# --- Semantic Layer 9: highlights ---
SHAPE $glint_top (PIXEL AT (VEC2 (PX $cx) (PX -2)))
SHAPE $glint_tl (PIXEL AT (VEC2 (PX (SUB $cx 9)) (PX 6)))
SHAPE $glint_tr (PIXEL AT (VEC2 (PX (ADD $cx 9)) (PX 6)))
SHAPE $glint_r (PIXEL AT (VEC2 (PX (ADD $cx 18)) (PX 16)))
LAYER highlights ORDER 80 {
  PAINT $glint_top FILL $canopy_spec RASTER CENTER
  PAINT $glint_tl FILL $canopy_spec RASTER CENTER
  PAINT $glint_tr FILL $canopy_spec RASTER CENTER
  PAINT $glint_r FILL $canopy_spec RASTER CENTER
}
