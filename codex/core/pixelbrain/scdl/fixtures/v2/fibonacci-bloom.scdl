SCDL 2
ASSET fibonacci_bloom
CANVAS WIDTH 32 HEIGHT 32
BUDGET INSTRUCTIONS 1000 GENERATED_SHAPES 50 RASTER_CELLS 1024 RECURSION_DEPTH 16

CONST $center VEC2 (VEC2 (PX 16) (PX 16))

FN compute_radius PARAM $step I32 RETURNS I32 {
  LET $base I32 (MUL $step 2)
  RETURN $base
}

SEQUENCE $fib TYPE I32 COUNT 6 {
  SEED 1
  SEED 2
  NEXT (ADD (PREV 1) (PREV 2))
}

RNG $rng ALGORITHM PCG32 SEED 4242

CONST $core_r I32 (AT $fib 2)
SHAPE $core (CIRCLE CENTER $center RADIUS (PX $core_r))

SHAPE $petals COMPOUND {
  RADIAL COUNT 6 CENTER $center RADIUS (PX 8) {
    EMIT (CIRCLE CENTER (VEC2 (PX 0) (PX 0)) RADIUS (PX 2))
  }
}

LAYER backdrop ORDER 0 {
  PAINT $core FILL #0F172A RASTER MIDPOINT
}

LAYER petals ORDER 10 {
  PAINT $petals FILL #38BDF8 RASTER MIDPOINT
}
