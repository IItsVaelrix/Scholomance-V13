SCDL 2
ASSET swaying_forest_sentinel
CANVAS WIDTH 32 HEIGHT 32

LAYER trunk ORDER 5 {
  PAINT (RECT ORIGIN (VEC2 (PX 14) (PX 16)) SIZE (VEC2 (PX 4) (PX 16))) FILL #5c3a21 RASTER CENTER
}

LAYER branch_l ORDER 10 {
  PAINT (RECT ORIGIN (VEC2 (PX 6) (PX 18)) SIZE (VEC2 (PX 8) (PX 2))) FILL #3d2616 RASTER CENTER
}

LAYER branch_r ORDER 11 {
  PAINT (RECT ORIGIN (VEC2 (PX 18) (PX 18)) SIZE (VEC2 (PX 8) (PX 2))) FILL #3d2616 RASTER CENTER
}

LAYER canopy ORDER 20 {
  PAINT (CIRCLE CENTER (VEC2 (PX 16) (PX 10)) RADIUS (PX 7)) FILL #2d5a27 RASTER CENTER
}

TIMELINE sway
  DURATION (MS 800)
  SAMPLE_RATE (FPS 12)
  LOOP REPEAT
{
  TRACK TARGET branch_l PROPERTY ROTATION {
    KEYFRAME AT (MS 0) VALUE (DEGREES 0) EASE SINE_IN_OUT
    KEYFRAME AT (MS 400) VALUE (DEGREES -15) EASE SINE_IN_OUT
    KEYFRAME AT (MS 800) VALUE (DEGREES 0) EASE SINE_IN_OUT
  }

  TRACK TARGET branch_r PROPERTY ROTATION {
    KEYFRAME AT (MS 0) VALUE (DEGREES 0) EASE SINE_IN_OUT
    KEYFRAME AT (MS 400) VALUE (DEGREES 15) EASE SINE_IN_OUT
    KEYFRAME AT (MS 800) VALUE (DEGREES 0) EASE SINE_IN_OUT
  }

  TRACK TARGET canopy PROPERTY TRANSFORM_X {
    FORMULA (MUL (PX 2) (SIN (MUL TAU $time_normalized)))
  }

  TRACK TARGET canopy PROPERTY OPACITY {
    KEYFRAME AT (MS 0) VALUE (RATIO 4 5) EASE LINEAR
    KEYFRAME AT (MS 400) VALUE (RATIO 1 1) EASE SINE_IN_OUT
    KEYFRAME AT (MS 800) VALUE (RATIO 4 5) EASE SINE_IN_OUT
  }
}
