# void_grove_grass_blades — real blade geometry from grass-amp.js, not
# per-pixel noise. Root-to-tip shading, deterministic volume distribution,
# two crisscrossing depth layers (back=taller/upright, front=shorter/leaning).
# Regenerate via generate-grass-blades.mjs, never hand-edit.
asset void_grove_grass_blades canvas 32x32

palette {
  soil_dark = #0e2a0b
  soil_base = #173a13
  soil_mid = #1f4718
  soil_lit = #28551f
  blade_root = #1e5518
  blade_low = #2d7322
  blade_mid = #4a9c2e
  blade_hi = #7fd13f
  blade_tip = #b6e85e
}

part ground material voidsoil {
  cell 0 0 soil_base
  cell 1 0 soil_lit
  cell 2 0 soil_base
