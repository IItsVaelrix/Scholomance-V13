# void_grove_grass_field — form-first field from grass-amp.js: a real
# height field (pits are literal depressions) plus real clump stroke
# geometry (root->tip); color is a lookup over the finished form, not a
# noise threshold or a hand-placed blade vector.
# Regenerate via generate-grass-field.mjs, never hand-edit.
asset void_grove_grass_field canvas 32x32

palette {
  soil = #0e2a0b
  bed = #173a13
  raised = #1f4718
  root = #28551f
  leaf = #4a9c2e
  tip = #b6e85e
}

